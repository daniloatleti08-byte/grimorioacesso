{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/acessar-grimorio", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/grimorio.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline; filename=\"grimorio-sao-bento.pdf\"" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
